<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <RanvierTrace Condition="'$(RanvierTrace)' == '' and '$(Configuration)' == 'Debug'">true</RanvierTrace>
    <RanvierTrace Condition="'$(RanvierTrace)' == ''">false</RanvierTrace>
    <DefineConstants Condition="'$(RanvierTrace)' == 'true'">$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shop.fs" />
    <Compile Include="Recording.fs" />
    <Compile Include="Program.fs" />
    <!-- Ranvier.Persistence left the core repository; the traced build takes the .Traced package family. -->
    <PackageReference Include="Ranvier.Persistence" Version="$(RanvierPersistenceVersion)" Condition="'$(RanvierTrace)' != 'true'" />
    <PackageReference Include="Ranvier.Persistence.Traced" Version="$(RanvierPersistenceVersion)" Condition="'$(RanvierTrace)' == 'true'" />
  </ItemGroup>
</Project>
